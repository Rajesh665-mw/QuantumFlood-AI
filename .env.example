# ===========================================================================
# QuantumFlood AI — Environment Variables Template
# ===========================================================================
# IMPORTANT:
# - Copy this file to .env or set these in your deployment dashboard (e.g. Vercel, Render).
# - NEVER commit production secrets or credentials to version control.
# ===========================================================================

# --- Frontend Configuration (Vercel / Vite) ---
# Base URL of the deployed FastAPI backend API.
# Leave blank or omit in local development to use the Vite proxy (http://localhost:8000).
# Example for production: https://quantumflood-backend.onrender.com
VITE_API_BASE_URL=

# --- Backend Configuration (FastAPI / ASGI) ---
# Host and port to bind when running backend
HOST=0.0.0.0
PORT=8000

# URL of the deployed frontend on Vercel (for CORS allowance)
# Example: https://quantumflood-ai.vercel.app
FRONTEND_URL=

# Additional allowed origins (comma-separated, optional)
# Example: https://my-custom-domain.com,https://preview.vercel.app
ALLOWED_ORIGINS=

# Allowed origin regex pattern for Vercel preview and production deployments
ALLOWED_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Allow all origins (set to true only for open demo environments, optional)
ALLOW_ALL_ORIGINS=false

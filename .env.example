# QuantumFlood AI — Environment Configuration Template
# Copy this file to .env for local development or set these variables in your hosting environment.
# DO NOT commit real secrets or credentials to source control.

# ==============================================================================
# Backend Configuration (FastAPI)
# ==============================================================================
# Port and Host
PORT=8000
HOST=0.0.0.0

# CORS & Allowed Origins
# Comma-separated list of allowed frontend origins (e.g. localhost, custom domains)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Regex for matching dynamic preview domains (e.g., Vercel previews)
ALLOWED_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Allow all origins (set to true ONLY for local debugging/demo, defaults to false)
ALLOW_ALL_ORIGINS=false

# Multi-User Session Isolation & Retention
# Legacy ambient state fallback (keep false for multi-user production deployments)
ENABLE_LEGACY_SHARED_STATE=false

# Analysis store retention period in hours
ANALYSIS_STORE_TTL_HOURS=24.0

# Maximum storage budget for analysis cache in megabytes
ANALYSIS_STORE_MAX_DISK_MB=500.0

# Maximum in-memory session cache entries
ANALYSIS_STORE_MAX_MEMORY=500

# ==============================================================================
# Frontend Configuration (Vite + React)
# ==============================================================================
# Base URL for the FastAPI backend.
# Local development default: left empty to use Vite proxy (/api -> http://localhost:8000).
# Production deployment: set to your deployed backend URL, e.g. https://api.quantumflood.org
VITE_API_BASE_URL=
